{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/web/*"],
      "@shared/*": ["src/shared/*"],
      "@packages/*": ["packages/*"],
      "@frigo/domain": ["packages/domain/src/index.ts"],
      "@frigo/recipes": ["packages/recipes/src/index.ts"],
      "@frigo/ai": ["packages/ai/src/index.ts"],
      "@frigo/db": ["packages/db/src/index.ts"]
    }
  },
  "include": [
    "src/web",
    "src/admin",
    "src/shared",
    "packages",
    "tests",
    "vite.config.ts"
  ]
}
