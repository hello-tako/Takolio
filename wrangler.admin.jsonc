// Takosan Admin Console Worker (separate deployment boundary from the customer Worker).
// NOT DEPLOYED. Disabled by default: the console stays 404 until ADMIN_CONSOLE_ENABLED=true,
// ADMIN_ORIGIN (dedicated https host), Cloudflare Access (team domain + AUD) are configured.
// Placeholders that must be replaced at integration: ADMIN_DB database_id, CACHE KV id, routes.
// Compile out the local-only password module in production and staging builds.
// R2 (F1): No direct customer D1 binding. Customer reads go strictly through the internal
// Service Binding CUSTOMER_READ -> takosan-admin-read-facade (AdminCustomerReadFacade).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takosan-admin",
  "main": "src/worker/admin-worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "define": { "__ADMIN_LOCAL_AUTH__": "false" },
  "workers_dev": false,
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "takosan-admin-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations-admin"
    }
  ],
  "services": [
    {
      "binding": "CUSTOMER_READ",
      "service": "takosan-admin-read-facade",
      "entrypoint": "AdminCustomerReadFacade"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_CONSOLE_ENABLED": "false",
    "ADMIN_AUTH_MODE": "cloudflare_access",
    "ADMIN_ORIGIN": "",
    "CUSTOMER_APP_URL": "https://frigo.tungjpstore.net",
    "ADMIN_ACCESS_TEAM_DOMAIN": "",
    "ADMIN_ACCESS_AUD": ""
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
