// LOCAL ONLY (pnpm admin:dev). Compiles in the development password login and binds the
// console to the loopback origin; a public host can never match ADMIN_ORIGIN. Do not deploy.
// R2 (F1): No direct customer D1 binding. Customer reads go strictly through CUSTOMER_READ.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takosan-admin-local",
  "main": "src/worker/admin-worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "takosan-admin-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations-admin"
    }
  ],
  "services": [
    {
      "binding": "CUSTOMER_READ",
      "service": "takosan-admin-read-facade-local",
      "entrypoint": "AdminCustomerReadFacade"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "define": {
    "__ADMIN_LOCAL_AUTH__": "true"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ADMIN_CONSOLE_ENABLED": "true",
    "ADMIN_AUTH_MODE": "password",
    "ADMIN_ORIGIN": "http://127.0.0.1:8799",
    "CUSTOMER_APP_URL": "http://127.0.0.1:8787"
  }
}
