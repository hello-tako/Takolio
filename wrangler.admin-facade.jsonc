// Takosan Admin Customer Read Facade Worker (R2 F1).
// Internal-only Worker: workers_dev=false, no routes, default HTTP fetch returns 404.
// Accessible only via Service Binding to AdminCustomerReadFacade entrypoint.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takosan-admin-read-facade",
  "main": "src/worker/admin-read-facade-worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_CUSTOMER_READ_DATABASE",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
