        "recipe_id": "imp-d3d0c59e0cfa845d",
        "step_number": 3,
        "instruction": "Đun nóng dầu trong chảo, đổ bột thành lớp mỏng, chiên lửa vừa đến khi mặt dưới vàng giòn rồi lật.",
        "tip": null,
        "timer_minutes": 6
      },
