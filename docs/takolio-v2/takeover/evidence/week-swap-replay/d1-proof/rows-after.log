        "recipe_id": "imp-d3d0c59e0cfa845d",
        "step_number": 2,
        "instruction": "Trộn 100g bột mì với 120ml nước lạnh, trứng, nước kim chi và chút muối thành bột sánh; cho kim chi và hành lá vào trộn đều.",
        "tip": null,
        "timer_minutes": null
      },
