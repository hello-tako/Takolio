        "recipe_id": "imp-af8a9cdb17d5e9fd",
        "step_number": 1,
        "instruction": "Thịt bò thái lát thật mỏng, ướp với xì dầu, 1 thìa đường, tỏi băm, chút dầu mè và tiêu trong 15 phút.",
        "tip": null,
        "timer_minutes": null
      },
