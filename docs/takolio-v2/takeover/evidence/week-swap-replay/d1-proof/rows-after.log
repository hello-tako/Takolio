        "id": "imp-f8fc539b7aa359ac_step_1",
        "recipe_id": "imp-f8fc539b7aa359ac",
        "step_number": 1,
        "instruction": "Dứa bỏ lõi cắt hạt lự. Tôm bóc vỏ rút chỉ.",
