        "recipe_id": "imp-a9398d96945ba6f7",
        "step_number": 2,
        "instruction": "Xào thịt ba chỉ với tỏi băm đến khi ra mỡ, cho kim chi vào xào cùng 3 phút.",
        "tip": null,
        "timer_minutes": 3
      },
      {
        "id": "imp-a9398d96945ba6f7_step_3",
        "recipe_id": "imp-a9398d96945ba6f7",
        "step_number": 3,
        "instruction": "Thêm 700ml nước, chút nước kim chi, 1 thìa tương ớt Hàn nếu có; đun sôi rồi hạ lửa nấu 15 phút.",
        "tip": null,
        "timer_minutes": 15
      },
      {
        "id": "imp-a9398d96945ba6f7_step_4",
        "recipe_id": "imp-a9398d96945ba6f7",
        "step_number": 4,
        "instruction": "Cho đậu phụ và hành tây vào nấu thêm 5 phút, nêm muối, rắc hành lá, dùng nóng với cơm.",
        "tip": null,
        "timer_minutes": null
      },
      {
