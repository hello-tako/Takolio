        "id": "imp-af8a9cdb17d5e9fd_step_2",
        "recipe_id": "imp-af8a9cdb17d5e9fd",
        "step_number": 2,
        "instruction": "Hành tây thái múi, cà rốt thái que mỏng, hành lá cắt khúc.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-af8a9cdb17d5e9fd_step_3",
        "recipe_id": "imp-af8a9cdb17d5e9fd",
        "step_number": 3,
        "instruction": "Xào hành tây và cà rốt với dầu trên lửa lớn 2 phút, cho thịt bò vào đảo nhanh đến khi chín tới.",
        "tip": "Xào từng ít một để thịt không ra nước và giữ độ mềm.",
        "timer_minutes": 5
      },
      {
        "id": "imp-af8a9cdb17d5e9fd_step_4",
        "recipe_id": "imp-af8a9cdb17d5e9fd",
        "step_number": 4,
        "instruction": "Rắc hành lá và vừng rang nếu có, dùng nóng với cơm hoặc lá rau cuốn.",
        "tip": null,
        "timer_minutes": null
      },
      {
