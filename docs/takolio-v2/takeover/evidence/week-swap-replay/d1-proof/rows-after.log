        "id": "imp-e28e249efceacac7_step_4",
        "recipe_id": "imp-e28e249efceacac7",
        "step_number": 4,
        "instruction": "Bày cùng rau sống và dưa leo, dùng với cơm trắng hoặc cơm nếp.",
