        "recipe_id": "imp-d3d0c59e0cfa845d",
        "step_number": 4,
        "instruction": "Cắt miếng vừa ăn, chấm xì dầu pha giấm và ớt bột.",
        "tip": null,
        "timer_minutes": null
      },
      {
