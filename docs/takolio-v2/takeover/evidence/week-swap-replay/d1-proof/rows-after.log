        "id": "imp-46962ad0d6f6e63b_step_2",
        "recipe_id": "imp-46962ad0d6f6e63b",
        "step_number": 2,
        "instruction": "Phi tỏi-ớt với dầu lửa lớn 30 giây, cho gà băm xào 3 phút tới săn.",
