        "id": "imp-f8fc539b7aa359ac_step_4",
        "recipe_id": "imp-f8fc539b7aa359ac",
        "step_number": 4,
        "instruction": "Nêm xì dầu-đường-chút cà ri? nêm xì dầu-đường cho chua ngọt cân bằng, trộn trứng và hành lá, dùng nóng.",
        "tip": null,
        "timer_minutes": null
