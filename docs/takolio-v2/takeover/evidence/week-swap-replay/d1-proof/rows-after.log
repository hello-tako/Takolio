        "id": "imp-26a36c69306143bc_step_3",
        "recipe_id": "imp-26a36c69306143bc",
        "step_number": 3,
        "instruction": "Phi thơm tỏi băm với dầu ăn, cho tôm vào xào lửa lớn đến khi tôm chuyển màu hồng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-26a36c69306143bc_step_4",
        "recipe_id": "imp-26a36c69306143bc",
        "step_number": 4,
        "instruction": "Cho bông cải vào xào cùng, nêm nước mắm và chút đường, đảo nhanh 2 phút rồi tắt bếp.",
        "tip": "Xào lửa lớn và nhanh tay để bông cải giữ độ giòn.",
        "timer_minutes": 2
      },
      {
        "id": "imp-b87b71d57128cc07_step_1",
        "recipe_id": "imp-b87b71d57128cc07",
        "step_number": 1,
        "instruction": "Cá lóc làm sạch, cắt khúc dày 3cm, khứa nhẹ hai mặt và để ráo.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-b87b71d57128cc07_step_2",
        "recipe_id": "imp-b87b71d57128cc07",
        "step_number": 2,
        "instruction": "Sả, ớt, tỏi băm nhuyễn; ướp cá với hỗn hợp này cùng chút muối, bột nghệ và tiêu trong 15 phút.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-b87b71d57128cc07_step_3",
        "recipe_id": "imp-b87b71d57128cc07",
        "step_number": 3,
        "instruction": "Đun nóng dầu ăn trong chảo sâu, cho cá vào chiên lửa vừa mỗi mặt đến khi vàng giòn.",
        "tip": "Lau khô cá trước khi chiên để dầu không bắn và da cá giòn hơn.",
        "timer_minutes": 10
      },
      {
        "id": "imp-b87b71d57128cc07_step_4",
        "recipe_id": "imp-b87b71d57128cc07",
        "step_number": 4,
        "instruction": "Vớt cá ra giấy thấm dầu. Pha nước mắm với chút đường, tỏi ớt băm và vài giọt nước cốt chanh để chấm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-b87b71d57128cc07_step_5",
        "recipe_id": "imp-b87b71d57128cc07",
        "step_number": 5,
        "instruction": "Xếp cá ra đĩa, rắc phần sả ớt còn lại đã phi vàng lên trên, dùng nóng với cơm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-511a92d180408e0a_step_1",
        "recipe_id": "imp-511a92d180408e0a",
        "step_number": 1,
        "instruction": "Nấm hương ngâm mềm, cắt hạt lựu. Thịt xay ướp với nước mắm, tiêu và hành lá cắt nhỏ.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-511a92d180408e0a_step_2",
        "recipe_id": "imp-511a92d180408e0a",
        "step_number": 2,
        "instruction": "Đánh tan trứng với 150ml nước ấm và chút muối, lọc qua rây cho mịn rồi trộn cùng thịt và nấm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-511a92d180408e0a_step_3",
        "recipe_id": "imp-511a92d180408e0a",
        "step_number": 3,
        "instruction": "Đổ hỗn hợp vào bát chịu nhiệt, đậy màng bọc hoặc đĩa, hấp lửa vừa đến khi trứng đông hoàn toàn.",
        "tip": "Hấp lửa vừa và đậy kín để mặt trứng không bị rỗ.",
        "timer_minutes": 15
      },
      {
        "id": "imp-511a92d180408e0a_step_4",
        "recipe_id": "imp-511a92d180408e0a",
        "step_number": 4,
        "instruction": "Rắc hành lá và tiêu lên mặt, rưới vài giọt nước mắm, dùng nóng với cơm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-d02c9b83214f81be_step_1",
        "recipe_id": "imp-d02c9b83214f81be",
        "step_number": 1,
        "instruction": "Luộc thịt ba chỉ chín, để nguội rồi thái lát mỏng. Tôm luộc chín, bóc vỏ, chẻ đôi.",
        "tip": null,
        "timer_minutes": 15
      },
      {
        "id": "imp-d02c9b83214f81be_step_2",
        "recipe_id": "imp-d02c9b83214f81be",
        "step_number": 2,
        "instruction": "Dưa leo bỏ ruột, thái lát chéo; cà rốt bào sợi. Ướp rau với chút muối 10 phút rồi vắt nhẹ cho ráo.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-d02c9b83214f81be_step_3",
        "recipe_id": "imp-d02c9b83214f81be",
        "step_number": 3,
        "instruction": "Pha nước trộn: nước mắm, 2 thìa đường, nước cốt chanh, tỏi ớt băm, khuấy tan.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-d02c9b83214f81be_step_4",
        "recipe_id": "imp-d02c9b83214f81be",
        "step_number": 4,
        "instruction": "Trộn dưa leo, cà rốt, tôm, thịt với nước trộn, để thấm 5 phút rồi bày ra đĩa, rắc rau răm và đậu phộng rang nếu có.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9ae951bec7fbf21b_step_1",
        "recipe_id": "imp-9ae951bec7fbf21b",
        "step_number": 1,
        "instruction": "Hủ tiếu trụng sơ nước sôi, xả nhanh và để ráo. Tôm bóc vỏ, ướp chút muối tiêu.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9ae951bec7fbf21b_step_2",
        "recipe_id": "imp-9ae951bec7fbf21b",
        "step_number": 2,
        "instruction": "Phi thơm tỏi với dầu ăn, xào tôm săn rồi trút ra để riêng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9ae951bec7fbf21b_step_3",
        "recipe_id": "imp-9ae951bec7fbf21b",
        "step_number": 3,
        "instruction": "Cho hủ tiếu vào chảo, rưới xì dầu và chút dầu hào nếu có, đảo nhanh trên lửa lớn cho sợi thấm đều.",
        "tip": null,
        "timer_minutes": 3
      },
      {
        "id": "imp-9ae951bec7fbf21b_step_4",
        "recipe_id": "imp-9ae951bec7fbf21b",
        "step_number": 4,
        "instruction": "Cho tôm, giá đỗ và hành lá cắt khúc vào đảo thêm 1 phút, nêm vừa miệng, rắc tiêu và dùng nóng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-5ab5c1053b7371f0_step_1",
        "recipe_id": "imp-5ab5c1053b7371f0",
        "step_number": 1,
        "instruction": "Đậu phụ cắt miếng vuông vừa ăn, thấm khô bằng khăn sạch.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-5ab5c1053b7371f0_step_2",
        "recipe_id": "imp-5ab5c1053b7371f0",
        "step_number": 2,
        "instruction": "Chiên đậu phụ trong dầu nóng đến khi vàng giòn các mặt, vớt ra để ráo.",
        "tip": null,
        "timer_minutes": 8
      },
      {
        "id": "imp-5ab5c1053b7371f0_step_3",
        "recipe_id": "imp-5ab5c1053b7371f0",
        "step_number": 3,
        "instruction": "Sả, ớt, tỏi băm nhuyễn; phi thơm với ít dầu còn lại trong chảo.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-5ab5c1053b7371f0_step_4",
        "recipe_id": "imp-5ab5c1053b7371f0",
        "step_number": 4,
        "instruction": "Cho đậu phụ trở lại chảo, rưới nước tương pha với chút đường, xóc đều cho thấm rồi tắt bếp.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-5ab5c1053b7371f0_step_5",
        "recipe_id": "imp-5ab5c1053b7371f0",
        "step_number": 5,
        "instruction": "Bày ra đĩa, rắc thêm sả ớt phi và tiêu, dùng nóng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-67054d03e5a5b011_step_1",
        "recipe_id": "imp-67054d03e5a5b011",
        "step_number": 1,
        "instruction": "Vo gạo, cho vào nồi với 1 lít nước, đun sôi rồi hạ lửa nhỏ nấu nhừ.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-67054d03e5a5b011_step_2",
        "recipe_id": "imp-67054d03e5a5b011",
        "step_number": 2,
        "instruction": "Khuấy đều thường xuyên để cháo không dính đáy nồi và sánh mịn.",
        "tip": null,
        "timer_minutes": 15
      },
      {
        "id": "imp-67054d03e5a5b011_step_3",
        "recipe_id": "imp-67054d03e5a5b011",
        "step_number": 3,
        "instruction": "Đánh tan trứng, đổ từ từ vào cháo đang sôi nhẹ, khuấy nhanh cho trứng tan thành vân.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-67054d03e5a5b011_step_4",
        "recipe_id": "imp-67054d03e5a5b011",
        "step_number": 4,
        "instruction": "Nêm nước mắm, chút muối, thêm gừng thái sợi và hành lá cắt nhỏ, rắc tiêu và dùng nóng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-e375595daced53af_step_1",
        "recipe_id": "imp-e375595daced53af",
        "step_number": 1,
        "instruction": "Thịt bò thái lát mỏng, ướp chút gừng, tỏi băm và tiêu. Rau muống nhặt ngọn, rửa sạch.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-e375595daced53af_step_2",
        "recipe_id": "imp-e375595daced53af",
        "step_number": 2,
        "instruction": "Dứa cắt miếng, cà chua cắt múi cau, sả đập dập cắt khúc.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-e375595daced53af_step_3",
        "recipe_id": "imp-e375595daced53af",
        "step_number": 3,
        "instruction": "Đun sôi 2 lít nước với sả, cho dứa và cà chua vào nấu 15 phút cho nước ngọt chua tự nhiên.",
        "tip": null,
        "timer_minutes": 15
      },
      {
        "id": "imp-e375595daced53af_step_4",
        "recipe_id": "imp-e375595daced53af",
        "step_number": 4,
        "instruction": "Nêm nước mắm, chút đường, muối và ớt cho vừa vị chua ngọt cay nhẹ.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-e375595daced53af_step_5",
        "recipe_id": "imp-e375595daced53af",
        "step_number": 5,
        "instruction": "Bày thịt bò, rau, bún ra bàn; khi ăn nhúng thịt và rau vào nước lẩu sôi, ăn kèm bún và nước mắm ớt.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9b4ea97916a44e67_step_1",
        "recipe_id": "imp-9b4ea97916a44e67",
        "step_number": 1,
        "instruction": "Rau muống nhặt bỏ lá già, cắt khúc 5cm, rửa sạch. Tôm bóc vỏ, giã dập với chút muối.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9b4ea97916a44e67_step_2",
        "recipe_id": "imp-9b4ea97916a44e67",
        "step_number": 2,
        "instruction": "Phi thơm tỏi băm với chút dầu, cho tôm vào xào săn rồi thêm 1 lít nước, đun sôi.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-9b4ea97916a44e67_step_3",
        "recipe_id": "imp-9b4ea97916a44e67",
        "step_number": 3,
        "instruction": "Cho rau muống vào, nấu sôi lại khoảng 3 phút cho rau vừa chín tới.",
        "tip": "Không đậy nắp để rau giữ được màu xanh.",
        "timer_minutes": 3
      },
      {
        "id": "imp-9b4ea97916a44e67_step_4",
        "recipe_id": "imp-9b4ea97916a44e67",
        "step_number": 4,
        "instruction": "Nêm nước mắm và chút muối, tắt bếp, có thể vắt thêm chanh khi ăn.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-6d7fc503ade5df6e_step_1",
        "recipe_id": "imp-6d7fc503ade5df6e",
        "step_number": 1,
        "instruction": "Thịt ba chỉ thái lát mỏng vừa ăn, ướp với nước mắm, chút đường và tiêu trong 10 phút.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-6d7fc503ade5df6e_step_2",
        "recipe_id": "imp-6d7fc503ade5df6e",
        "step_number": 2,
        "instruction": "Sả bóc lớp vỏ già, cùng ớt và tỏi băm thật nhuyễn để dậy mùi khi xào.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-6d7fc503ade5df6e_step_3",
        "recipe_id": "imp-6d7fc503ade5df6e",
        "step_number": 3,
        "instruction": "Cho thịt vào chảo nóng, xào lửa lớn đến khi thịt ra mỡ và xém vàng cạnh.",
        "tip": null,
        "timer_minutes": 6
      },
      {
        "id": "imp-6d7fc503ade5df6e_step_4",
        "recipe_id": "imp-6d7fc503ade5df6e",
        "step_number": 4,
        "instruction": "Cho sả ớt tỏi vào đảo cùng đến khi dậy mùi thơm, nêm lại cho vừa miệng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-6d7fc503ade5df6e_step_5",
        "recipe_id": "imp-6d7fc503ade5df6e",
        "step_number": 5,
        "instruction": "Thêm hành lá cắt khúc, đảo nhanh rồi tắt bếp, dùng nóng với cơm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-364497296cfcf033_step_1",
        "recipe_id": "imp-364497296cfcf033",
        "step_number": 1,
        "instruction": "Mực làm sạch, giữ nguyên thân ống, râu mực băm nhỏ. Nấm ngâm mềm, cắt hạt lựu.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-364497296cfcf033_step_2",
        "recipe_id": "imp-364497296cfcf033",
        "step_number": 2,
        "instruction": "Trộn thịt xay với râu mực, nấm, hành lá băm, nước mắm và tiêu; nhồi vào thân mực, dùng tăm ghim miệng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-364497296cfcf033_step_3",
        "recipe_id": "imp-364497296cfcf033",
        "step_number": 3,
        "instruction": "Xếp mực lên đĩa, rải gừng thái sợi, hấp lửa lớn đến khi mực chín và nhân săn lại.",
        "tip": "Không nhồi quá chặt để mực không bị nứt khi hấp.",
        "timer_minutes": 15
      },
      {
        "id": "imp-364497296cfcf033_step_4",
        "recipe_id": "imp-364497296cfcf033",
        "step_number": 4,
        "instruction": "Lấy ra, cắt khoanh vừa ăn, rưới nước hấp và rắc hành lá, chấm nước mắm gừng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-806780abda4b5205_step_1",
        "recipe_id": "imp-806780abda4b5205",
        "step_number": 1,
        "instruction": "Tôm bóc vỏ, cắt hạt lựu. Dứa cắt hạt lựu. Cơm nguội bóp tơi.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-806780abda4b5205_step_2",
        "recipe_id": "imp-806780abda4b5205",
        "step_number": 2,
        "instruction": "Phi thơm hành lá phần đầu trắng với dầu, cho tôm xào săn rồi đổ trứng vào đảo tơi.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-806780abda4b5205_step_3",
        "recipe_id": "imp-806780abda4b5205",
        "step_number": 3,
        "instruction": "Cho cơm vào xào lửa lớn, đảo đều đến khi hạt cơm săn và tơi.",
        "tip": null,
        "timer_minutes": 5
      },
      {
        "id": "imp-806780abda4b5205_step_4",
        "recipe_id": "imp-806780abda4b5205",
        "step_number": 4,
        "instruction": "Thêm dứa, nêm nước mắm và chút tiêu, đảo thêm 1 phút; rắc hành lá và dùng nóng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-a48b19224e397cea_step_1",
        "recipe_id": "imp-a48b19224e397cea",
        "step_number": 1,
        "instruction": "Nấu cơm. Hành tây thái múi mỏng, gừng thái sợi, thịt bò thái lát thật mỏng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-a48b19224e397cea_step_2",
        "recipe_id": "imp-a48b19224e397cea",
        "step_number": 2,
        "instruction": "Đun 200ml nước với xì dầu, 1 thìa đường và chút rượu mirin nếu có, cho hành tây vào nấu mềm.",
        "tip": null,
        "timer_minutes": 5
      },
      {
        "id": "imp-a48b19224e397cea_step_3",
        "recipe_id": "imp-a48b19224e397cea",
        "step_number": 3,
        "instruction": "Cho thịt bò và gừng vào, nấu lửa vừa đến khi thịt vừa chín, vớt bọt.",
        "tip": null,
        "timer_minutes": 4
      },
      {
        "id": "imp-a48b19224e397cea_step_4",
        "recipe_id": "imp-a48b19224e397cea",
        "step_number": 4,
        "instruction": "Múc cơm ra tô, xếp thịt bò và hành tây lên trên, rưới nước sốt, rắc hành lá và tiêu.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-79819e1b0c75f4da_step_1",
        "recipe_id": "imp-79819e1b0c75f4da",
        "step_number": 1,
        "instruction": "Trụng mì udon trong nước sôi 1 phút, xả nước và để ráo. Thịt ba chỉ thái mỏng, bắp cải thái sợi, cà rốt thái que.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-79819e1b0c75f4da_step_2",
        "recipe_id": "imp-79819e1b0c75f4da",
        "step_number": 2,
        "instruction": "Xào thịt ba chỉ với dầu đến khi xém vàng, cho cà rốt và bắp cải vào xào mềm.",
        "tip": null,
        "timer_minutes": 5
      },
      {
        "id": "imp-79819e1b0c75f4da_step_3",
        "recipe_id": "imp-79819e1b0c75f4da",
        "step_number": 3,
        "instruction": "Cho mì vào chảo, rưới xì dầu và chút dầu hào, đảo trên lửa lớn cho sợi mì thấm đều.",
        "tip": null,
        "timer_minutes": 3
      },
      {
        "id": "imp-79819e1b0c75f4da_step_4",
        "recipe_id": "imp-79819e1b0c75f4da",
        "step_number": 4,
        "instruction": "Rắc hành lá, tiêu, đảo đều rồi dọn ra đĩa dùng nóng.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-ac255bcc36d1324e_step_1",
        "recipe_id": "imp-ac255bcc36d1324e",
        "step_number": 1,
        "instruction": "Cá hồi thấm khô, ướp chút muối tiêu. Pha sốt: xì dầu, 1 thìa đường, 2 thìa nước, gừng và tỏi băm.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-ac255bcc36d1324e_step_2",
        "recipe_id": "imp-ac255bcc36d1324e",
        "step_number": 2,
        "instruction": "Áp chảo cá hồi với dầu, mặt da xuống trước, lửa vừa đến khi da giòn rồi lật mặt.",
        "tip": null,
        "timer_minutes": 6
      },
      {
        "id": "imp-ac255bcc36d1324e_step_3",
        "recipe_id": "imp-ac255bcc36d1324e",
        "step_number": 3,
        "instruction": "Rưới sốt vào chảo, đun nhỏ lửa cho sốt sánh và bám bóng lên miếng cá.",
        "tip": "Không lật cá nhiều lần để miếng cá không vỡ.",
        "timer_minutes": 3
      },
      {
        "id": "imp-ac255bcc36d1324e_step_4",
        "recipe_id": "imp-ac255bcc36d1324e",
        "step_number": 4,
        "instruction": "Bày cá ra đĩa, rưới sốt còn lại, rắc hành lá thái nhỏ.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-bb07db73fb381724_step_1",
        "recipe_id": "imp-bb07db73fb381724",
        "step_number": 1,
        "instruction": "Đậu phụ non để ráo, cắt khối vuông, ướp lạnh trong tủ mát 30 phút nếu có thời gian.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-bb07db73fb381724_step_2",
        "recipe_id": "imp-bb07db73fb381724",
        "step_number": 2,
        "instruction": "Gừng gọt vỏ bào nhuyễn, hành lá thái thật nhỏ.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-bb07db73fb381724_step_3",
        "recipe_id": "imp-bb07db73fb381724",
        "step_number": 3,
        "instruction": "Xếp đậu phụ ra đĩa, đặt gừng và hành lá lên mặt, rưới xì dầu ngay trước khi ăn.",
        "tip": null,
        "timer_minutes": null
      },
      {
        "id": "imp-bb07db73fb381724_step_4",
        "recipe_id": "imp-bb07db73fb381724",
        "step_number": 4,
        "instruction": "Dùng lạnh; có thể thêm rong biển vụn hoặc vừng rang nếu có.",
        "tip": "Chọn đậu phụ non mềm để món ăn mát mịn đúng vị.",
        "timer_minutes": null
      },
      {
        "id": "imp-a9398d96945ba6f7_step_1",
        "recipe_id": "imp-a9398d96945ba6f7",
        "step_number": 1,
        "instruction": "Thịt ba chỉ thái miếng vừa ăn, kim chi cắt khúc, đậu phụ cắt khối, hành tây thái múi.",
