{
  "openapi": "3.1.0",
  "info": {
    "title": "Tako-san billing account and admission contract",
    "version": "2-candidate"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "x-status": "LOCAL_CANDIDATE_PENDING_EXTERNAL_EVIDENCE",
  "paths": {
    "/billing/plans": {
      "get": {
        "security": [
          {
            "CookieSession": []
          }
        ],
        "x-owner-scope": "authenticated non-guest; expected owner headers and CSRF on POST",
        "responses": {
          "200": {
            "description": "Authoritative server prices and exact admission capability",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingPlansResponseSchema"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "503": {
            "description": "Database unavailable or PAYMENT_PRICE_CONFIGURATION_INVALID"
          }
        }
      }
    },
    "/billing/account": {
      "get": {
        "security": [
          {
            "CookieSession": []
          }
        ],
        "x-owner-scope": "authenticated non-guest; expected owner headers and CSRF on POST",
        "description": "Read-only owner snapshot of current entitlement and latest20 payments, ordered by creation time then id descending. hasMore indicates older history; hasPendingPayment also covers outstanding orders outside the page, legacy pending orders and unresolved admissions. A paid order with a persisted verified provider reference no longer blocks creation, even if its admission outcome remained uncertain. Resumable instructions are read separately by id; history omits bank and provider data. Subscription expiry and history timestamps are canonical UTC ISO values.",
        "responses": {
          "200": {
            "description": "Owner-only entitlement, bounded history and outstanding-payment fence",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingAccountResponseSchema"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "403": {
            "description": "SESSION_OWNER_MISMATCH"
          },
          "409": {
            "description": "BILLING_ACCOUNT_INVALID; no partial history"
          },
          "503": {
            "description": "DATABASE_UNAVAILABLE or BILLING_ACCOUNT_UNAVAILABLE"
          }
        }
      }
    },
    "/billing/checkouts": {
      "get": {
        "security": [
          {
            "CookieSession": []
          }
        ],
        "x-owner-scope": "authenticated non-guest; expected owner headers and CSRF on POST",
        "responses": {
          "200": {
            "description": "Owner-only reload recovery handles; verified paid orders omitted",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenCheckoutsResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/billing/checkouts/{id}": {
      "get": {
        "security": [
          {
            "CookieSession": []
          }
        ],
        "x-owner-scope": "authenticated non-guest; expected owner headers and CSRF on POST",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resume owned instructions without dispatch",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingCreatedResponseSchema"
                }
              }
            }
          },
          "202": {
            "description": "Reconciliation required",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutUncertainSchema"
                }
              }
            }
          },
          "404": {
            "description": "Disabled, foreign or missing"
          },
          "409": {
            "description": "Expired or active attempt"
          }
        }
      }
    },
    "/billing/payment-intents": {
      "post": {
        "security": [
          {
            "CookieSession": []
          }
        ],
        "x-owner-scope": "authenticated non-guest; expected owner headers and CSRF on POST",
        "description": "With admission enabled, creation atomically forbids a new offer while the owner has a pending order or unresolved admission, including legacy orders. Verified paid orders with a persisted provider reference are excluded from this fence. Same-key replay preserves the issued offer. An omitted key uses a server-generated durable key and retains stored instructions for account recovery. With admission disabled, omitted-key creation retains legacy behavior; supplied keys fail closed.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "description": "Available only when checkoutAdmissionEnabled is true. Same-key changed plan conflicts. Keep the key through transport failure to replay the exact offer. Without a supplied key, recover an admitted order from billing account history rather than dispatching another."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plan": {
                    "type": "string",
                    "enum": [
                      "monthly",
                      "annual"
                    ]
                  }
                },
                "required": [
                  "plan"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original offer replay",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingCreatedResponseSchema"
                }
              }
            }
          },
          "201": {
            "description": "One newly admitted offer",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingCreatedResponseSchema"
                }
              }
            }
          },
          "202": {
            "description": "Remote outcome unknown; existing intent handle, no replacement dispatch",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutUncertainSchema"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_PLAN or INVALID_IDEMPOTENCY_KEY"
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "409": {
            "description": "IDEMPOTENCY_CONFLICT, COMMAND_IN_PROGRESS (including an existing owner pending order) or CHECKOUT_KEY_EXPIRED"
          },
          "429": {
            "description": "Creation rate limit (fail closed)"
          },
          "503": {
            "description": "Provider, rate-limit or database unavailable, disabled admission or invalid trusted price configuration"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BillingPlanRequestSchema": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ]
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      },
      "CheckoutKeySchema": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{16,128}$"
      },
      "BillingPlansResponseSchema": {
        "type": "object",
        "properties": {
          "checkoutAdmissionEnabled": {
            "type": "boolean",
            "default": false
          },
          "plans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "plan": {
                  "type": "string",
                  "enum": [
                    "monthly",
                    "annual"
                  ]
                },
                "amountVnd": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "const": "VND"
                }
              },
              "required": [
                "plan",
                "amountVnd",
                "currency"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "x-runtime-validation": true
          }
        },
        "required": [
          "plans"
        ],
        "additionalProperties": false
      },
      "BillingCreatedResponseSchema": {
        "type": "object",
        "properties": {
          "success": {
            "const": true
          },
          "payment": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "enum": [
                  "monthly",
                  "annual"
                ]
              },
              "amountVnd": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "currency": {
                "const": "VND"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "orderCode": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "expiresAt": {
                "type": "string",
                "minLength": 1,
                "x-runtime-validation": true
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "paid",
                  "failed",
                  "expired",
                  "refunded"
                ]
              },
              "instructions": {
                "type": "object",
                "properties": {
                  "bankBin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accountNumber": {
                    "type": "string",
                    "minLength": 1
                  },
                  "accountName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transferContent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qrImageUrl": {
                    "type": "string",
                    "x-runtime-validation": true
                  }
                },
                "required": [
                  "bankBin",
                  "accountNumber",
                  "accountName",
                  "transferContent",
                  "qrImageUrl"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "plan",
              "amountVnd",
              "currency",
              "id",
              "orderCode",
              "description",
              "expiresAt",
              "status",
              "instructions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "success",
          "payment"
        ],
        "additionalProperties": false
      },
      "CheckoutUncertainSchema": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "code": {
            "const": "PAYMENT_RECONCILIATION_REQUIRED"
          },
          "intentId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "success",
          "code",
          "intentId"
        ],
        "additionalProperties": false
      },
      "OpenCheckoutsResponseSchema": {
        "type": "object",
        "properties": {
          "checkouts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "intentId": {
                  "type": "string",
                  "minLength": 1
                },
                "plan": {
                  "type": "string",
                  "enum": [
                    "monthly",
                    "annual"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "paid",
                    "failed",
                    "expired",
                    "refunded"
                  ]
                },
                "expiresAt": {
                  "type": "string",
                  "minLength": 1,
                  "x-runtime-validation": true
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "dispatching",
                    "ready",
                    "remote_uncertain"
                  ]
                }
              },
              "required": [
                "intentId",
                "plan",
                "status",
                "expiresAt",
                "state"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          }
        },
        "required": [
          "checkouts"
        ],
        "additionalProperties": false
      },
      "BillingAccountResponseSchema": {
        "type": "object",
        "properties": {
          "subscription": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "enum": [
                  "free",
                  "plus"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "expired",
                  "inactive"
                ]
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "x-runtime-validation": true
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "plan",
              "status",
              "expiresAt"
            ],
            "additionalProperties": false,
            "x-runtime-validation": true
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "plan": {
                  "type": "string",
                  "enum": [
                    "monthly",
                    "annual"
                  ]
                },
                "amountVnd": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "const": "VND"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "orderCode": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "expiresAt": {
                  "type": "string",
                  "minLength": 1,
                  "x-runtime-validation": true
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "paid",
                    "failed",
                    "expired",
                    "refunded"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "minLength": 1,
                  "x-runtime-validation": true
                },
                "canResume": {
                  "type": "boolean"
                },
                "checkoutState": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "dispatching",
                        "ready",
                        "remote_uncertain"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "plan",
                "amountVnd",
                "currency",
                "id",
                "orderCode",
                "description",
                "expiresAt",
                "status",
                "createdAt",
                "canResume",
                "checkoutState"
              ],
              "additionalProperties": false,
              "x-runtime-validation": true
            },
            "maxItems": 20,
            "x-runtime-validation": true
          },
          "hasMore": {
            "type": "boolean"
          },
          "hasPendingPayment": {
            "type": "boolean"
          }
        },
        "required": [
          "subscription",
          "payments",
          "hasMore",
          "hasPendingPayment"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "CookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-frigo_session"
      }
    }
  },
